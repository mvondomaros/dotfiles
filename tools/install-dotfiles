#!/bin/sh
# Configuration only. No network access, packages, or shell changes.
set -eu
repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
backup=false
host=
role=
while [ "$#" -gt 0 ]; do
    case $1 in
        --host) [ "$#" -ge 2 ] || exit 2; host=$2; shift ;;
        --role) [ "$#" -ge 2 ] || exit 2; role=$2; shift ;;
        --backup) backup=true ;;
        --help) printf 'Usage: %s [--host NAME] [--role workstation|server] [--backup]\n' "$0"; exit 0 ;;
        *) printf 'Unknown argument: %s\n' "$1" >&2; exit 2 ;;
    esac
    shift
done
case $host in *[!a-zA-Z0-9_-]*) printf 'Invalid host name\n' >&2; exit 2 ;; esac
case $role in ''|workstation|server) ;; *) printf 'Invalid role: %s\n' "$role" >&2; exit 2 ;; esac
backup_dir=${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/backups/$(date +%Y%m%d-%H%M%S)-$$
backup_file() {
    relative=${1#"$HOME"/}
    mkdir -p "$backup_dir/$(dirname "$relative")"
    mv "$1" "$backup_dir/$relative"
    printf 'backup: %s\n' "$backup_dir/$relative"
}
link_file() {
    src=$1
    dst=$2
    if [ -e "$dst" ] && [ "$dst" -ef "$src" ]; then
        printf 'ok: %s\n' "$dst"
        return
    fi
    if [ -e "$dst" ] || [ -L "$dst" ]; then
        if [ "$backup" = false ]; then
            printf 'skip: %s exists (use --backup to preserve and replace it)\n' "$dst" >&2
            return
        fi
        backup_file "$dst"
    fi
    mkdir -p "$(dirname "$dst")"
    ln -s "$src" "$dst"
    printf 'link: %s\n' "$dst"
}
link_git_config() {
    # A symlinked git/ makes ../dotfiles/local resolve inside the checkout.
    git_dir=$config_home/git
    if [ -L "$git_dir" ] || { [ -e "$git_dir" ] && [ ! -d "$git_dir" ]; }; then
        if [ "$backup" = false ]; then
            printf 'skip: %s must be a real directory (use --backup to preserve and replace it)\n' "$git_dir" >&2
            return
        fi
        backup_file "$git_dir"
    fi
    mkdir -p "$git_dir"
    link_file "$repo_dir/git/config" "$git_dir/config"
}
mkdir -p "$config_home" "$config_home/dotfiles/local"
for entry in bash atuin eza fzf lazygit nvim pixi starship.toml vimrc vim-colors; do
    link_file "$repo_dir/$entry" "$config_home/$entry"
done
link_git_config
for entry in platforms hosts; do
    link_file "$repo_dir/dotfiles/$entry" "$config_home/dotfiles/$entry"
done
if [ "$(uname -s)" = Darwin ]; then
    for entry in fish kitty ideavim; do
        link_file "$repo_dir/$entry" "$config_home/$entry"
    done
    link_file "$config_home/ideavim/ideavimrc" "$HOME/.ideavimrc"
fi
link_file "$config_home/bash/bashrc" "$HOME/.bashrc"
link_file "$config_home/bash/bash_profile" "$HOME/.bash_profile"
link_file "$config_home/vimrc" "$HOME/.vimrc"
if [ -n "$host" ]; then
    printf '%s\n' "$host" > "$config_home/dotfiles/local/host"
fi
if [ -n "$role" ]; then
    role_temp=$(mktemp "$config_home/dotfiles/local/.role.XXXXXX")
    trap 'rm -f "$role_temp"' EXIT HUP INT TERM
    printf '%s\n' "$role" > "$role_temp"
    mv "$role_temp" "$config_home/dotfiles/local/role"
    trap - EXIT HUP INT TERM
    printf 'role: %s\n' "$role"
fi
mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/vim/undo"
printf '\nConfiguration installed. Packages and login shells were not changed.\n'
