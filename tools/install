#!/bin/sh

set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

link_file() {
    source_path=$1
    target_path=$2

    if [ -L "$target_path" ] && [ "$target_path" -ef "$source_path" ]; then
        printf 'ok: %s\n' "$target_path"
        return
    fi

    if [ -e "$target_path" ] || [ -L "$target_path" ]; then
        printf 'skip: %s already exists\n' "$target_path" >&2
        return
    fi

    ln -s "$source_path" "$target_path"
    printf 'link: %s -> %s\n' "$target_path" "$source_path"
}

if git -C "$repo_dir" submodule status --recursive | grep -q '^-'; then
    git -C "$repo_dir" submodule update --init --recursive
fi

link_file "$repo_dir/bash/bashrc" "$HOME/.bashrc"
link_file "$repo_dir/bash/bash_profile" "$HOME/.bash_profile"
link_file "$repo_dir/ideavim/ideavimrc" "$HOME/.ideavimrc"
link_file "$repo_dir/vimrc" "$HOME/.vimrc"
link_file "$repo_dir/vmdrc" "$HOME/.vmdrc"

printf '\nConfiguration installed. Existing files were left untouched.\n'
