after idle {

  display update off

  foreach {c r g b} {
    blue     0.6000 0.7000 0.9200
    red      0.9200 0.6200 0.6200
    gray     0.5850 0.5850 0.6100
    orange   0.9200 0.7000 0.5000
    yellow   0.9000 0.8600 0.4500
    tan      0.9200 0.7800 0.5800
    silver   0.8700 0.8700 0.8800
    green    0.4800 0.8600 0.5400
    white    0.9800 0.9800 0.9750
    pink     0.9200 0.6600 0.8200
    cyan     0.4500 0.8200 0.8200
    purple   0.7800 0.6200 0.9200
    lime     0.7000 0.8800 0.4500
    mauve    0.9000 0.6800 0.9000
    ochre    0.9000 0.7600 0.4600
    iceblue  0.5000 0.7200 0.9200
    black    0.1200 0.1200 0.1300
  } {
    color change rgb $c $r $g $b
  }

  foreach c {
    yellow2 yellow3 green2 green3 cyan2 cyan3 blue2 blue3
    violet violet2 magenta magenta2 red2 red3 orange2 orange3
  } {
    color change rgb $c 1.0 1.0 1.0
  }

  color Display Background orange3

  menu main on
  menu tkcon on
  menu main move 50 20
  menu tkcon move 700 20
  display resize 1200 900
  display reposition 50 920

  catch { display rendermode GLSL }
  display antialias on
  display projection orthographic
  display depthcue off
  axes location off
  stage location off

  light 0 on
  light 1 on
  light 2 on
  light 3 off
  light 0 pos { 0.30  0.40  1.00 }
  light 1 pos {-0.80  0.20  0.60 }
  light 2 pos { 0.10 -0.60 -1.00 }

  display shadows on
  display ambientocclusion on
  display aoambient 0.90
  display aodirect  0.28

  catch { material add PastelAO }
  material change ambient   PastelAO 0.12
  material change diffuse   PastelAO 0.75
  material change specular  PastelAO 0.50
  material change shininess PastelAO 0.70
  material change mirror    PastelAO 0.00
  material change opacity   PastelAO 1.00
  catch { mol default material PastelAO }

  display update on
  display update
}
