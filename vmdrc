###############################################################################
# 2) Materials: sphere-optimized pastel materials (AO/shadow friendly)
###############################################################################

# Helper: define/update a material consistently (create if missing)
proc ::vmdrc_define_material {name amb diff spec shin opac} {
    catch { material add $name }
    material change ambient   $name $amb
    material change diffuse   $name $diff
    material change specular  $name $spec
    material change shininess $name $shin
    material change opacity   $name $opac
}

# Spheres: minimize specular hotspots; keep AO clean.
# (Specular kept at 0; shininess low; ambient slightly elevated for dense packs)
::vmdrc_define_material PastelSphere       0.35 0.65 0.00 0.05 1.00
::vmdrc_define_material PastelSphereTrans  0.35 0.65 0.00 0.05 0.35

# General-purpose pastel materials
::vmdrc_define_material PastelMatte        0.35 0.75 0.00 0.05 1.00
::vmdrc_define_material PastelSoft         0.30 0.70 0.08 0.12 1.00
::vmdrc_define_material PastelTrans        0.30 0.70 0.05 0.10 0.40


###############################################################################
# 3) Display settings (robustly applied after idle)
###############################################################################
after idle {
    # Display settings:
    display backgroundgradient on
    display shadows on
    display ambientocclusion on
    display aodirect 0.35
    display depthcue off
    display projection Orthographic
    display rendermode GLSL 

    # Background colors
    color Display Background white
    color Display BackgroundBot iceblue
}

