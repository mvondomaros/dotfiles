# Shared SSH client defaults. Host entries stay private in
# ~/.config/dotfiles/local/ssh/*.conf (included first, so they take precedence).
Include ~/.config/dotfiles/local/ssh/*.conf

Host *
    ServerAliveInterval 15
    ServerAliveCountMax 3
    AddKeysToAgent yes
    IgnoreUnknown UseKeychain
    UseKeychain yes
    # Opt-in per host in the private layer; also overrides system-wide defaults.
    ForwardAgent no
    # Reuse one connection per destination.
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 10m
