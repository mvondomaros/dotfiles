# Environment is intentionally safe for SSH commands and batch jobs.
source "${XDG_CONFIG_HOME:-$HOME/.config}/bash/plugins/environment.sh"
case $- in *i*) ;; *) return ;; esac

mkdir -p "$XDG_DATA_HOME/bash" "$XDG_CACHE_HOME/bash" "$XDG_STATE_HOME"
BASH_DATA_HOME="$XDG_DATA_HOME/bash"
set -o vi

# Shared interactive defaults, then platform/host/private overrides.
for _plugin in options history editor aliases pixi browse; do
    source "$XDG_CONFIG_HOME/bash/plugins/$_plugin.sh"
done

for _config in     "$DOTFILES_HOME/platforms/$DOTFILES_PLATFORM/bash.sh"     "$DOTFILES_HOME/hosts/$DOTFILES_HOST/bash.sh"     "$DOTFILES_HOME/local/bash.sh"
do
    [ ! -r "$_config" ] || source "$_config"
done

for _plugin in atuin starship; do
    source "$XDG_CONFIG_HOME/bash/plugins/$_plugin.sh"
done
unset _config _plugin
